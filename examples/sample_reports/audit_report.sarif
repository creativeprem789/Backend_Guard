          "level": "error",
          "message": {
            "text": "Production debug mode hardcoded to True: debug=True explicitly passed to framework call."
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "app/main.py",
                  "uriBaseId": "%SRCROOT%"
                },
                "region": {
