        },
        {
          "ruleId": "FASTAPI-001",
          "level": "error",
          "message": {
            "text": "Direct raw SQL execution inside route endpoint: Raw SQL execution inside route 'get_user'."
          },
          "locations": [
            {
              "physicalLocation": {
